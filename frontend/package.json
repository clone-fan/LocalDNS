{
  "name": "localdns-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "verify:generated": "node scripts/verify-build.mjs",
    "check": "npm run typecheck && npm run test && npm run lint && npm run verify:generated"
  },
  "devDependencies": {
    "@csstools/postcss-cascade-layers": "6.0.2",
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "eslint": "10.13.0",
    "globals": "17.4.0",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "dompurify": "3.4.17"
  }
}
